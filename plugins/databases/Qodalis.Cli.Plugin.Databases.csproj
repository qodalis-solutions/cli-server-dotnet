<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Qodalis.Cli.Plugin.Databases</RootNamespace>
    <Version>1.0.0-beta.29</Version>
    <Description>Databases for Qodalis CLI Server: size, connections, load and largest tables of PostgreSQL, MySQL, SQL Server and SQLite databases, and their migrations (versioned schema changes applied under a lock, tracked and run from the dashboard, the terminal, MCP and the API)</Description>
    <Authors>Nicolae Lupei</Authors>
    <Company>Qodalis Solutions</Company>
    <PackageProjectUrl>https://qodalis.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/qodalis-solutions/cli-server-dotnet</RepositoryUrl>
    <PackageTags>cli;qodalis;databases;migrations;database;plugin</PackageTags>
    <PackageOutputPath>nupkg\</PackageOutputPath>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Qodalis.Cli.Tests" />
    <InternalsVisibleTo Include="Qodalis.Cli.Plugin.Databases.EfCore" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="True" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Qodalis.Cli\Qodalis.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.*" />
  </ItemGroup>
  <!-- The dashboard's Databases page (@qodalis/cli-dashboard-module-databases), embedded and served at /qcli/databases:
       the sibling repo's build, else the npm package when installed -->
  <PropertyGroup>
    <DatabasesPageSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', 'cli-server-dashboard', 'modules', 'databases', 'dist'))</DatabasesPageSourceDir>
    <DatabasesPageNpmDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'node_modules', '@qodalis', 'cli-dashboard-module-databases', 'dist'))</DatabasesPageNpmDir>
    <DatabasesPageStagingDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot', 'databases'))</DatabasesPageStagingDir>
  </PropertyGroup>
  <Target Name="CopyDatabasesPage" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <DatabasesPageResolvedDir Condition="Exists('$(DatabasesPageSourceDir)extension.js')">$(DatabasesPageSourceDir)</DatabasesPageResolvedDir>
      <DatabasesPageResolvedDir Condition="'$(DatabasesPageResolvedDir)' == '' AND Exists('$(DatabasesPageNpmDir)extension.js')">$(DatabasesPageNpmDir)</DatabasesPageResolvedDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(DatabasesPageResolvedDir)' != ''">
      <DatabasesPageFiles Include="$(DatabasesPageResolvedDir)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DatabasesPageFiles)" DestinationFolder="$(DatabasesPageStagingDir)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'$(DatabasesPageResolvedDir)' != ''" />
    <Message Importance="high" Text="Databases page not found: the dashboard will not show it." Condition="'$(DatabasesPageResolvedDir)' == '' AND !Exists('$(DatabasesPageStagingDir)extension.js')" />
  </Target>
  <Target Name="IncludeDatabasesPage" BeforeTargets="PrepareForBuild;GenerateEmbeddedFilesManifest" DependsOnTargets="CopyDatabasesPage">
    <ItemGroup Condition="Exists('$(DatabasesPageStagingDir)')">
      <EmbeddedResource Include="wwwroot/databases/**/*.*" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- The package's icon on the admin dashboard's plugins page (CliInstalledPlugin.Icon) -->
    <AssemblyMetadata Include="QodalisCliIcon" Value="🗄️" />
  </ItemGroup>
</Project>
