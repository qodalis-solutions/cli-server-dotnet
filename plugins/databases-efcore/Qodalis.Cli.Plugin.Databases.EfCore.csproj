<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Qodalis.Cli.Plugin.Databases.EfCore</RootNamespace>
    <Version>1.0.0-beta.33</Version>
    <Description>EF Core for the Qodalis CLI databases plugin: a DbContext's migrations shown, applied and rolled back from the dashboard, the terminal and MCP, and the schema helpers of the CLI's EF Core stores</Description>
    <Authors>Nicolae Lupei</Authors>
    <Company>Qodalis Solutions</Company>
    <PackageProjectUrl>https://qodalis.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/qodalis-solutions/cli-server-dotnet</RepositoryUrl>
    <PackageTags>cli;qodalis;databases;migrations;efcore;plugin</PackageTags>
    <PackageOutputPath>nupkg\</PackageOutputPath>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="True" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
    <None Include="README.md" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../databases/Qodalis.Cli.Plugin.Databases.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <!-- The EF Core stores' default dialect: works after an install from the marketplace (postgres and mssql are added by the host) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package's icon on the admin dashboard's plugins page (CliInstalledPlugin.Icon) -->
    <AssemblyMetadata Include="QodalisCliIcon" Value="🗄️" />
    <!-- A library of the EF Core stores (users-efcore, audit-efcore, ...), installed with them: nothing to install alone -->
    <AssemblyMetadata Include="QodalisCliAutoInstall" Value="false" />
    <AssemblyMetadata Include="QodalisCliAutoInstallReason" Value="a library of the EF Core stores, installed with them (users-efcore, audit-efcore, jobs-efcore, ...)" />
  </ItemGroup>
</Project>
