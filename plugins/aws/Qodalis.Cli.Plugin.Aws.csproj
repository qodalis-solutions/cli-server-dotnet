<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Qodalis.Cli.Plugin.Aws</RootNamespace>
    <Version>1.0.0-beta.25</Version>
    <Description>AWS cloud resource management plugin for Qodalis CLI Server</Description>
    <Authors>Nicolae Lupei</Authors>
    <Company>Qodalis Solutions</Company>
    <PackageProjectUrl>https://qodalis.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/qodalis-solutions/cli-server-dotnet</RepositoryUrl>
    <PackageTags>cli;qodalis;aws;cloud;plugin</PackageTags>
    <PackageOutputPath>nupkg\</PackageOutputPath>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="True" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Qodalis.Cli.Abstractions/Qodalis.Cli.Abstractions.csproj" />
    <ProjectReference Include="../../src/Qodalis.Cli/Qodalis.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.*" />
    <PackageReference Include="AWSSDK.EC2" Version="3.*" />
    <PackageReference Include="AWSSDK.Lambda" Version="3.*" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.*" />
    <PackageReference Include="AWSSDK.SQS" Version="3.*" />
    <PackageReference Include="AWSSDK.IdentityManagement" Version="3.*" />
    <PackageReference Include="AWSSDK.CloudWatch" Version="3.*" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="3.*" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.*" />
    <PackageReference Include="AWSSDK.ECS" Version="3.*" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.*" />
    <PackageReference Include="AWSSDK.SSO" Version="3.*" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="3.*" />
  </ItemGroup>
</Project>
