<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Qodalis.Cli.Plugin.Users</RootNamespace>
    <Version>1.0.0-beta.29</Version>
    <Description>User management plugin for Qodalis CLI Server — authentication, sessions, groups, and audit log</Description>
    <Authors>Nicolae Lupei</Authors>
    <Company>Qodalis Solutions</Company>
    <PackageProjectUrl>https://qodalis.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/qodalis-solutions/cli-server-dotnet</RepositoryUrl>
    <PackageTags>cli;qodalis;users;auth;sessions;plugin</PackageTags>
    <PackageOutputPath>nupkg\</PackageOutputPath>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="True" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Qodalis.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Qodalis.Cli\Qodalis.Cli.csproj" />
    <ProjectReference Include="..\audit\Qodalis.Cli.Plugin.Audit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package's icon on the admin dashboard's plugins page (CliInstalledPlugin.Icon) -->
    <AssemblyMetadata Include="QodalisCliIcon" Value="👥" />
  </ItemGroup>
  <!-- The dashboard's pages this package serves (build/Qcli.DashboardModules.targets) -->
  <ItemGroup>
    <QcliDashboardModule Include="tokens" />
  </ItemGroup>
  <Import Project="..\..\build\Qcli.DashboardModules.targets" />
</Project>
