<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Qodalis.Cli.Plugin.Portal</RootNamespace>
    <Version>1.0.0-beta.35</Version>
    <Description>Portal plugin for Qodalis CLI Server: the prebuilt documentation site (guides and API reference) at one mount</Description>
    <Authors>Nicolae Lupei</Authors>
    <Company>Qodalis Solutions</Company>
    <PackageProjectUrl>https://qodalis.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/qodalis-solutions/cli-server-dotnet</RepositoryUrl>
    <PackageTags>cli;qodalis;portal;docs;api;openapi;plugin</PackageTags>
    <PackageOutputPath>nupkg\</PackageOutputPath>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Qodalis.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="True" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
    <None Include="README.md" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Qodalis.Cli\Qodalis.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
  </ItemGroup>

  <!-- Portal site embedding (as the admin plugin's dashboard) -->
  <PropertyGroup>
    <PortalSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', 'cli-server-dashboard', 'portal', 'dist'))</PortalSourceDir>
    <PortalNpmDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'node_modules', '@qodalis', 'cli-server-portal', 'dist'))</PortalNpmDir>
    <PortalStagingDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot', 'portal'))</PortalStagingDir>
  </PropertyGroup>

  <!-- Auto-install npm package when neither sibling repo nor node_modules exist -->
  <Target Name="NpmInstallPortal" BeforeTargets="ResolvePortal"
          Condition="!Exists('$(PortalSourceDir)') AND !Exists('$(PortalNpmDir)')">
    <Message Importance="high" Text="Portal site not found locally or in node_modules. Running npm install..." />
    <Exec Command="npm install --ignore-scripts" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true" />
  </Target>

  <!-- Resolve the site directory: prefer the sibling repo, fall back to the npm package -->
  <Target Name="ResolvePortal" BeforeTargets="CopyPortalFiles" DependsOnTargets="NpmInstallPortal">
    <PropertyGroup>
      <PortalResolvedDir Condition="Exists('$(PortalSourceDir)')">$(PortalSourceDir)</PortalResolvedDir>
      <PortalResolvedDir Condition="'$(PortalResolvedDir)' == '' AND Exists('$(PortalNpmDir)')">$(PortalNpmDir)</PortalResolvedDir>
    </PropertyGroup>
    <Message Importance="high" Text="Portal site resolved: $(PortalResolvedDir)" Condition="'$(PortalResolvedDir)' != ''" />
    <Message Importance="high" Text="Portal site not found. The portal will not be available." Condition="'$(PortalResolvedDir)' == ''" />
  </Target>

  <Target Name="CopyPortalFiles" BeforeTargets="PrepareForBuild" DependsOnTargets="ResolvePortal">
    <ItemGroup Condition="'$(PortalResolvedDir)' != ''">
      <PortalFiles Include="$(PortalResolvedDir)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(PortalFiles)" DestinationFolder="$(PortalStagingDir)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'$(PortalResolvedDir)' != ''" />
  </Target>

  <Target Name="IncludePortalEmbeddedResources" BeforeTargets="PrepareForBuild;GenerateEmbeddedFilesManifest" DependsOnTargets="CopyPortalFiles">
    <ItemGroup Condition="Exists('$(PortalStagingDir)')">
      <EmbeddedResource Include="wwwroot/portal/**/*.*" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- The package's icon on the admin dashboard's plugins page (CliInstalledPlugin.Icon) -->
    <AssemblyMetadata Include="QodalisCliIcon" Value="🌐" />
  </ItemGroup>
</Project>
