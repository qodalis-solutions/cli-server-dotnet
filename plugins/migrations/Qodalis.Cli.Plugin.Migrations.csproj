<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Qodalis.Cli.Plugin.Migrations</RootNamespace>
    <Version>1.0.0-beta.29</Version>
    <Description>Database migrations for Qodalis CLI Server: versioned schema changes of PostgreSQL, MySQL, SQL Server and SQLite databases, applied under a lock, tracked and run from the dashboard, the terminal, MCP and the API</Description>
    <Authors>Nicolae Lupei</Authors>
    <Company>Qodalis Solutions</Company>
    <PackageProjectUrl>https://qodalis.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/qodalis-solutions/cli-server-dotnet</RepositoryUrl>
    <PackageTags>cli;qodalis;migrations;database;plugin</PackageTags>
    <PackageOutputPath>nupkg\</PackageOutputPath>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Qodalis.Cli.Tests" />
    <InternalsVisibleTo Include="Qodalis.Cli.Plugin.Migrations.EfCore" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="True" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Qodalis.Cli\Qodalis.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.*" />
  </ItemGroup>
  <!-- The dashboard's Migrations page (@qodalis/cli-dashboard-module-migrations), embedded and served at /qcli/migrations:
       the sibling repo's build, else the npm package when installed -->
  <PropertyGroup>
    <MigrationsPageSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', 'cli-server-dashboard', 'modules', 'migrations', 'dist'))</MigrationsPageSourceDir>
    <MigrationsPageNpmDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'node_modules', '@qodalis', 'cli-dashboard-module-migrations', 'dist'))</MigrationsPageNpmDir>
    <MigrationsPageStagingDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot', 'migrations'))</MigrationsPageStagingDir>
  </PropertyGroup>
  <Target Name="CopyMigrationsPage" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <MigrationsPageResolvedDir Condition="Exists('$(MigrationsPageSourceDir)extension.js')">$(MigrationsPageSourceDir)</MigrationsPageResolvedDir>
      <MigrationsPageResolvedDir Condition="'$(MigrationsPageResolvedDir)' == '' AND Exists('$(MigrationsPageNpmDir)extension.js')">$(MigrationsPageNpmDir)</MigrationsPageResolvedDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(MigrationsPageResolvedDir)' != ''">
      <MigrationsPageFiles Include="$(MigrationsPageResolvedDir)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(MigrationsPageFiles)" DestinationFolder="$(MigrationsPageStagingDir)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'$(MigrationsPageResolvedDir)' != ''" />
    <Message Importance="high" Text="Migrations page not found: the dashboard will not show it." Condition="'$(MigrationsPageResolvedDir)' == '' AND !Exists('$(MigrationsPageStagingDir)extension.js')" />
  </Target>
  <Target Name="IncludeMigrationsPage" BeforeTargets="PrepareForBuild;GenerateEmbeddedFilesManifest" DependsOnTargets="CopyMigrationsPage">
    <ItemGroup Condition="Exists('$(MigrationsPageStagingDir)')">
      <EmbeddedResource Include="wwwroot/migrations/**/*.*" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- The package's icon on the admin dashboard's plugins page (CliInstalledPlugin.Icon) -->
    <AssemblyMetadata Include="QodalisCliIcon" Value="🗄️" />
  </ItemGroup>
</Project>
