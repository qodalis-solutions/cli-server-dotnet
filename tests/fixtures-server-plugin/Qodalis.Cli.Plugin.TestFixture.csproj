<Project Sdk="Microsoft.NET.Sdk">
  <!-- A tiny server plugin for the tests of runtime-installed plugins: built against the server, never referenced by the
       tests (so it is not in their dependencies), copied next to them and loaded through a CliPluginLoadContext. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Qodalis.Cli\Qodalis.Cli.csproj" Private="false" />
    <ProjectReference Include="..\..\src\Qodalis.Cli.Abstractions\Qodalis.Cli.Abstractions.csproj" Private="false" />
  </ItemGroup>
</Project>
